{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "noEmitOnError": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["control/**/*.ts", "microvm/server.ts", "scripts/*.ts"],
  "exclude": ["**/node_modules", "control/dist"]
}
